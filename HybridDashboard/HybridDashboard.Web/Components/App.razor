<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/HybridDashboard.Shared/app.css" />
    <link rel="stylesheet" href="HybridDashboard.Web.styles.css" />
    <link href="_content/Syncfusion.Blazor.Themes/bootstrap5.css" rel="stylesheet" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
    <style>
        .host-grid {
            display: grid;
            grid-template-rows: auto 1fr; 
            grid-template-columns: 1fr;
            gap: 12px;
            height: 100vh;
            box-sizing: border-box;
            padding: 12px;
            background: var(--bs-body-bg, #f8f9fa);
        }

        .host-summary {
            background: transparent;
            overflow: hidden;
            padding: 8px 4px;
        }

        .host-content {
            overflow: auto;
            background: transparent;
            padding: 4px;
        }

        .web-card {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        }

        .web-card img {
            width: 64px;
            height: 64px;
            object-fit: contain;
            border-radius: 6px;
        }

        .web-card .value {
            font-size: 22px;
            font-weight: 700;
            text-align: center;
        }

        .web-card .title {
            font-size: 22px;
            font-weight: 700;
            text-align: center;
        }

        .summary-sfcard .e-card {
            height: 100% !important;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            border: 1px solid rgba(0,0,0,0.06);
        }

        .summary-sfcard .e-card .e-card-content {
            padding: 18px;
        }

        .summary-sfcard .summary-value {
            font-weight: 700;
            font-size: 28px;
            color: #222;
        }

        .summary-sfcard .summary-sub {
            font-size: 12px;
            color: #6c757d;
        }

        .summary-row {
            display:flex;
            gap:12px;
            align-items:stretch;
            overflow-x:auto;
            padding:8px 4px;
        }

        .summary-row > .summary-card {
            min-width: 220px;
            flex: 1 1 0;
        }

    </style>
</head>

<body>
    <div class="host-grid">
        <div class="host-summary">
            <div class="summary-sfcard">
                <HybridDashboard.Web.Components.Pages.SummaryCard />
            </div>
        </div>

        <div class="host-content">
            <Routes @rendermode="InteractiveServer" />
        </div>
    </div>

    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js" type="text/javascript"></script>
</body>

</html>